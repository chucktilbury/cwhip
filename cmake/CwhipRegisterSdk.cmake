# Records the installed SDK prefix and application defaults in
# <config-home>/cwhip/sdk.toml. Included by the install step; also usable as
# `cmake -DCWHIP_SDK_PREFIX=<prefix> -DCWHIP_BUILD_TYPE=<type> -P
# CwhipRegisterSdk.cmake` (tests).
#
# The file is edited line by line so unrelated settings, comments, and
# formatting are preserved. Errors are fatal so a failed registration fails
# `cmake --install`.

function(cwhip_toml_basic_string value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(cwhip_register_sdk prefix)
    if(ARGC GREATER 1)
        set(build_type "${ARGV1}")
    else()
        set(build_type "")
    endif()
    if(NOT "$ENV{DESTDIR}" STREQUAL "")
        message(STATUS "DESTDIR is set; not recording SDK defaults (staged prefix is not a runtime path)")
        return()
    endif()
    if(prefix STREQUAL "" OR NOT IS_ABSOLUTE "${prefix}")
        message(FATAL_ERROR "Cannot record sdk_prefix: install prefix '${prefix}' is not absolute")
    endif()
    string(REGEX REPLACE "(.)/+$" "\\1" prefix "${prefix}")

    if(NOT "$ENV{XDG_CONFIG_HOME}" STREQUAL "")
        set(config_home "$ENV{XDG_CONFIG_HOME}")
    elseif(NOT "$ENV{HOME}" STREQUAL "")
        set(config_home "$ENV{HOME}/.config")
    else()
        message(FATAL_ERROR "Cannot record sdk_prefix: neither XDG_CONFIG_HOME nor HOME is set")
    endif()
    if(NOT IS_ABSOLUTE "${config_home}")
        message(FATAL_ERROR "Cannot record sdk_prefix: config home '${config_home}' is not absolute")
    endif()
    set(settings_directory "${config_home}/cwhip")
    set(settings_file "${settings_directory}/sdk.toml")

    cwhip_toml_basic_string("${prefix}" encoded)
    set(new_line "sdk_prefix = ${encoded}")
    cwhip_toml_basic_string("${prefix}" encoded_application_prefix)
    cwhip_toml_basic_string("${build_type}" encoded_build_type)
    set(new_application_prefix "install_prefix = ${encoded_application_prefix}")
    set(new_build_type "build_type = ${encoded_build_type}")

    # Protect list metacharacters so arbitrary file content survives splitting.
    string(ASCII 1 semicolon_token)
    string(ASCII 2 open_token)
    string(ASCII 3 close_token)
    set(eol "\n")
    set(content "")
    if(EXISTS "${settings_file}")
        if(IS_DIRECTORY "${settings_file}")
            message(FATAL_ERROR "Cannot record sdk_prefix: ${settings_file} is a directory")
        endif()
        file(READ "${settings_file}" content)
    endif()
    if(content MATCHES "\r\n")
        set(eol "\r\n")
    endif()
    string(REPLACE ";" "${semicolon_token}" content "${content}")
    string(REPLACE "[" "${open_token}" content "${content}")
    string(REPLACE "]" "${close_token}" content "${content}")
    # Prefix every line with a token so blank lines survive list handling.
    string(ASCII 4 line_token)
    set(had_final_newline FALSE)
    if(content MATCHES "\n$")
        set(had_final_newline TRUE)
        string(REGEX REPLACE "\n$" "" content "${content}")
    endif()
    if(content STREQUAL "" AND NOT had_final_newline)
        set(lines "")
    else()
        string(REPLACE "\n" ";${line_token}" lines "${line_token}${content}")
    endif()

    set(output_lines "")
    set(in_table FALSE)
    set(in_applications_table FALSE)
    set(applications_table_found FALSE)
    set(application_prefix_found FALSE)
    set(build_type_found FALSE)
    set(in_multiline "")
    set(array_depth 0)
    set(replaced FALSE)
    set(insert_index -1)
    set(index 0)
    set(application_cr "")
    if(eol STREQUAL "\r\n")
        set(application_cr "\r")
    endif()
    foreach(line IN LISTS lines)
        string(REPLACE "${line_token}" "" line "${line}")
        if(in_applications_table AND line MATCHES "^[ \t]*${open_token}")
            if(NOT application_prefix_found)
                list(APPEND output_lines "${line_token}${new_application_prefix}${application_cr}")
            endif()
            if(NOT build_type_found)
                list(APPEND output_lines "${line_token}${new_build_type}${application_cr}")
            endif()
            set(in_applications_table FALSE)
        endif()
        set(emit "${line}")
        set(is_top_key FALSE)
        if(line MATCHES "^[ \t]*${open_token}applications${close_token}[ \t]*(#.*)?$")
            set(in_applications_table TRUE)
            set(applications_table_found TRUE)
            set(application_prefix_found FALSE)
            set(build_type_found FALSE)
        elseif(in_applications_table
               AND line MATCHES "^[ \t]*install_prefix[ \t]*=[ \t]*(\"\"\"|''')")
            message(FATAL_ERROR
                "Cannot update install_prefix in ${settings_file}: multi-line string value; edit it manually")
        elseif(in_applications_table
               AND line MATCHES "^[ \t]*build_type[ \t]*=[ \t]*(\"\"\"|''')")
            message(FATAL_ERROR
                "Cannot update build_type in ${settings_file}: multi-line string value; edit it manually")
        elseif(in_applications_table
               AND line MATCHES "^[ \t]*install_prefix[ \t]*=")
            set(application_prefix_found TRUE)
            if(line MATCHES "\r$")
                set(emit "${new_application_prefix}\r")
            else()
                set(emit "${new_application_prefix}")
            endif()
        elseif(in_applications_table
               AND line MATCHES "^[ \t]*build_type[ \t]*=")
            set(build_type_found TRUE)
            if(line MATCHES "\r$")
                set(emit "${new_build_type}\r")
            else()
                set(emit "${new_build_type}")
            endif()
        endif()
        if(NOT in_table AND in_multiline STREQUAL "" AND array_depth EQUAL 0)
            if(line MATCHES "^[ \t]*${open_token}")
                set(in_table TRUE)
                if(insert_index LESS 0)
                    set(insert_index ${index})
                endif()
            elseif(line MATCHES "^[ \t]*(sdk_prefix|\"sdk_prefix\"|'sdk_prefix')[ \t]*=[ \t]*(\"\"\"|''')")
                message(FATAL_ERROR
                    "Cannot update sdk_prefix in ${settings_file}: multi-line string value; edit it manually")
            elseif(line MATCHES "^[ \t]*(sdk_prefix|\"sdk_prefix\"|'sdk_prefix')[ \t]*=")
                set(is_top_key TRUE)
                if(line MATCHES "\r$")
                    set(emit "${new_line}\r")
                else()
                    set(emit "${new_line}")
                endif()
                set(replaced TRUE)
            endif()
        endif()
        if(NOT in_table)
            # Track multi-line strings and arrays so continuation lines are
            # never mistaken for table headers or keys.
            set(scan "${line}")
            if(NOT in_multiline STREQUAL "")
                if(scan MATCHES "${in_multiline}")
                    string(REGEX REPLACE "^.*${in_multiline}" "" scan "${scan}")
                    set(in_multiline "")
                endif()
            elseif(NOT is_top_key AND scan MATCHES "=")
                if(scan MATCHES "\"\"\"")
                    string(REGEX MATCHALL "\"\"\"" quotes "${scan}")
                    list(LENGTH quotes quote_count)
                    math(EXPR odd "${quote_count} % 2")
                    if(odd)
                        set(in_multiline "\"\"\"")
                    endif()
                elseif(scan MATCHES "'''")
                    string(REGEX MATCHALL "'''" quotes "${scan}")
                    list(LENGTH quotes quote_count)
                    math(EXPR odd "${quote_count} % 2")
                    if(odd)
                        set(in_multiline "'''")
                    endif()
                endif()
            endif()
            if(in_multiline STREQUAL "" AND scan MATCHES "=" OR array_depth GREATER 0)
                string(REGEX REPLACE "\"[^\"]*\"|'[^']*'|#.*$" "" bracket_scan "${scan}")
                if(array_depth EQUAL 0)
                    string(REGEX REPLACE "^[^=]*=" "" bracket_scan "${bracket_scan}")
                endif()
                string(REGEX MATCHALL "${open_token}" opens "${bracket_scan}")
                string(REGEX MATCHALL "${close_token}" closes "${bracket_scan}")
                list(LENGTH opens open_count)
                list(LENGTH closes close_count)
                math(EXPR array_depth "${array_depth} + ${open_count} - ${close_count}")
                if(array_depth LESS 0)
                    set(array_depth 0)
                endif()
            endif()
        endif()
        list(APPEND output_lines "${line_token}${emit}")
        math(EXPR index "${index} + 1")
    endforeach()

    if(NOT replaced)
        set(cr "")
        if(eol STREQUAL "\r\n")
            set(cr "\r")
        endif()
        if(insert_index GREATER_EQUAL 0)
            list(INSERT output_lines ${insert_index}
                "${line_token}${new_line}${cr}" "${line_token}${cr}")
        else()
            list(APPEND output_lines "${line_token}${new_line}${cr}")
            set(had_final_newline TRUE)
        endif()
    endif()

    if(in_applications_table)
        if(NOT application_prefix_found)
            list(APPEND output_lines "${line_token}${new_application_prefix}${application_cr}")
            set(had_final_newline TRUE)
        endif()
        if(NOT build_type_found)
            list(APPEND output_lines "${line_token}${new_build_type}${application_cr}")
            set(had_final_newline TRUE)
        endif()
    elseif(NOT applications_table_found)
        list(LENGTH output_lines output_line_count)
        if(output_line_count GREATER 0)
            list(APPEND output_lines "${line_token}${application_cr}")
        endif()
        list(APPEND output_lines "${line_token}${open_token}applications${close_token}${application_cr}"
            "${line_token}${new_application_prefix}${application_cr}"
            "${line_token}${new_build_type}${application_cr}")
        set(had_final_newline TRUE)
    endif()

    string(REPLACE ";" "\n" result "${output_lines}")
    string(REPLACE "${line_token}" "" result "${result}")
    if(had_final_newline OR NOT replaced)
        string(APPEND result "\n")
    endif()
    string(REPLACE "${semicolon_token}" ";" result "${result}")
    string(REPLACE "${open_token}" "[" result "${result}")
    string(REPLACE "${close_token}" "]" result "${result}")

    file(MAKE_DIRECTORY "${settings_directory}")
    if(NOT IS_DIRECTORY "${settings_directory}")
        message(FATAL_ERROR "Cannot create ${settings_directory} to record sdk_prefix")
    endif()
    set(original "")
    if(EXISTS "${settings_file}")
        file(READ "${settings_file}" original)
    endif()
    if(NOT EXISTS "${settings_file}" OR NOT original STREQUAL result)
        file(WRITE "${settings_file}" "${result}")
        file(READ "${settings_file}" written)
        if(NOT written STREQUAL result)
            message(FATAL_ERROR "Failed to write sdk_prefix to ${settings_file}")
        endif()
    endif()
    message(STATUS "Recorded Cwhip application defaults in ${settings_file}")
endfunction()

if(DEFINED CWHIP_SDK_PREFIX)
    if(DEFINED CWHIP_BUILD_TYPE)
        cwhip_register_sdk("${CWHIP_SDK_PREFIX}" "${CWHIP_BUILD_TYPE}")
    else()
        cwhip_register_sdk("${CWHIP_SDK_PREFIX}" "")
    endif()
endif()
