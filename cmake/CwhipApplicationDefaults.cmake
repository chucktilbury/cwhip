include_guard(GLOBAL)

function(_cwhip_decode_application_setting line key output)
    string(REGEX REPLACE "^[ \t]*${key}[ \t]*=[ \t]*" "" value "${line}")
    if(NOT value MATCHES "^\".*\"([ \t]*#.*)?$")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    string(REGEX REPLACE "^\"(.*)\"[ \t]*(#.*)?$" "\\1" value "${value}")
    string(ASCII 1 escaped_backslash)
    string(REPLACE "\\\\" "${escaped_backslash}" value "${value}")
    string(REPLACE "\\\"" "\"" value "${value}")
    string(REPLACE "\\n" "\n" value "${value}")
    string(REPLACE "\\r" "\r" value "${value}")
    string(REPLACE "\\t" "\t" value "${value}")
    string(REPLACE "${escaped_backslash}" "\\" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(cwhip_apply_application_defaults)
    if(NOT DEFINED Cwhip_PREFIX OR Cwhip_PREFIX STREQUAL "")
        message(FATAL_ERROR
            "cwhip_apply_application_defaults() must be called after find_package(Cwhip)")
    endif()

    if(NOT "$ENV{XDG_CONFIG_HOME}" STREQUAL "")
        set(config_home "$ENV{XDG_CONFIG_HOME}")
    elseif(NOT "$ENV{HOME}" STREQUAL "")
        set(config_home "$ENV{HOME}/.config")
    else()
        return()
    endif()
    set(settings_file "${config_home}/cwhip/sdk.toml")
    if(NOT EXISTS "${settings_file}" OR IS_DIRECTORY "${settings_file}")
        return()
    endif()

    file(READ "${settings_file}" content)
    string(ASCII 2 semicolon_token)
    string(REPLACE ";" "${semicolon_token}" content "${content}")
    string(REPLACE "\r\n" "\n" content "${content}")
    string(REPLACE "\r" "\n" content "${content}")
    string(REPLACE "\n" ";" lines "${content}")

    set(in_top_level TRUE)
    set(in_applications_table FALSE)
    set(registered_prefix "")
    set(application_prefix "")
    set(application_build_type "")
    foreach(line IN LISTS lines)
        string(REPLACE "${semicolon_token}" ";" line "${line}")
        if(line MATCHES "^[ \t]*\\[applications\\][ \t]*(#.*)?$")
            set(in_top_level FALSE)
            set(in_applications_table TRUE)
        elseif(line MATCHES "^[ \t]*\\[")
            set(in_top_level FALSE)
            set(in_applications_table FALSE)
        elseif(in_top_level AND line MATCHES "^[ \t]*sdk_prefix[ \t]*=")
            _cwhip_decode_application_setting("${line}" "sdk_prefix" registered_prefix)
        elseif(in_applications_table AND line MATCHES "^[ \t]*install_prefix[ \t]*=")
            _cwhip_decode_application_setting("${line}" "install_prefix" application_prefix)
        elseif(in_applications_table AND line MATCHES "^[ \t]*build_type[ \t]*=")
            _cwhip_decode_application_setting("${line}" "build_type" application_build_type)
        endif()
    endforeach()

    if(registered_prefix STREQUAL "" OR application_prefix STREQUAL "")
        return()
    endif()
    get_filename_component(registered_prefix "${registered_prefix}" REALPATH)
    get_filename_component(selected_prefix "${Cwhip_PREFIX}" REALPATH)
    if(NOT registered_prefix STREQUAL selected_prefix)
        return()
    endif()

    set(Cwhip_APPLICATION_INSTALL_PREFIX "${application_prefix}" PARENT_SCOPE)
    set(Cwhip_APPLICATION_BUILD_TYPE "${application_build_type}" PARENT_SCOPE)
    get_property(install_prefix_cached CACHE CMAKE_INSTALL_PREFIX PROPERTY TYPE SET)
    if(NOT install_prefix_cached AND NOT DEFINED CMAKE_INSTALL_PREFIX
       AND "$ENV{CMAKE_INSTALL_PREFIX}" STREQUAL "")
        set(CMAKE_INSTALL_PREFIX "${application_prefix}" CACHE PATH
            "Install path prefix, inherited from the selected Cwhip SDK" FORCE)
        set(CMAKE_INSTALL_PREFIX "${application_prefix}" PARENT_SCOPE)
    endif()
    get_property(build_type_cached CACHE CMAKE_BUILD_TYPE PROPERTY TYPE SET)
    if(NOT build_type_cached AND NOT CMAKE_CONFIGURATION_TYPES
       AND (NOT DEFINED CMAKE_BUILD_TYPE OR "${CMAKE_BUILD_TYPE}" STREQUAL ""))
        if(DEFINED ENV{CMAKE_BUILD_TYPE})
            set(build_type_default "$ENV{CMAKE_BUILD_TYPE}")
        else()
            set(build_type_default "${application_build_type}")
        endif()
        set(CMAKE_BUILD_TYPE "${build_type_default}" CACHE STRING
            "Build type inherited from Cwhip or the CMake environment" FORCE)
        set(CMAKE_BUILD_TYPE "${build_type_default}" PARENT_SCOPE)
    endif()
endfunction()
