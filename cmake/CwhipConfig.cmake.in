@PACKAGE_INIT@
set(Cwhip_PREFIX "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Python3 3.11 COMPONENTS Interpreter)
find_program(Cwhip_CLANG_EXECUTABLE NAMES clang REQUIRED)
if("${CMAKE_CURRENT_BINARY_DIR}" MATCHES "[ \t]")
    # GNU ld depfiles do not escape spaces; CMake's explicit dependencies remain.
    set(CMAKE_LINK_DEPENDS_USE_LINKER FALSE)
endif()
set(Cwhip_VERSION "@PROJECT_VERSION@")
set(Cwhip_APPLICATION_OUTPUT_DIRECTORIES TRUE)
set(PACKAGE_PREFIX_DIR "${Cwhip_PREFIX}")
set_and_check(Cwhip_COMPILER "@PACKAGE_CMAKE_INSTALL_BINDIR@/cwhip")
set_and_check(Cwhip_PACKAGE_TOOL "@PACKAGE_CMAKE_INSTALL_BINDIR@/cwhip-pkg")
set_and_check(Cwhip_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(Cwhip_RUNTIME_LIBRARY "@PACKAGE_CMAKE_INSTALL_LIBDIR@/cwhip/@CMAKE_STATIC_LIBRARY_PREFIX@cwhip_runtime@CMAKE_STATIC_LIBRARY_SUFFIX@")
set_and_check(Cwhip_MODULE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/cwhip/modules")
set_and_check(Cwhip_BUILTIN_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/cwhip/builtin")
set(Cwhip_GTK @CWHIP_GTK@)
set(Cwhip_SOURCEVIEW @CWHIP_GTK_SOURCEVIEW@)
foreach(required
    "${Cwhip_INCLUDE_DIR}/cwhip/Stdlib.h"
    "${Cwhip_INCLUDE_DIR}/cwhip/RuntimeGc.h"
    "${Cwhip_BUILTIN_DIR}/String.cw")
    if(NOT EXISTS "${required}")
        set(Cwhip_FOUND FALSE)
        set(Cwhip_NOT_FOUND_MESSAGE "Incomplete Cwhip SDK: missing ${required}")
        return()
    endif()
endforeach()
execute_process(COMMAND "${Cwhip_COMPILER}" --version
    RESULT_VARIABLE result OUTPUT_VARIABLE version ERROR_VARIABLE error)
string(STRIP "${version}" version)
if(NOT result EQUAL 0 OR NOT version STREQUAL "cwhip: v@PROJECT_VERSION@")
    set(Cwhip_FOUND FALSE)
    set(Cwhip_NOT_FOUND_MESSAGE "Cwhip executable/version check failed: ${version}${error}")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CwhipApplication.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CwhipApplicationDefaults.cmake")
check_required_components(Cwhip)
