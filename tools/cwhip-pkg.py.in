#!/usr/bin/env python3
"""MVP project package manager for Cwhip."""

from __future__ import annotations

import argparse
import functools
import hashlib
import http.client
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import zipfile
import zlib

if sys.version_info < (3, 11):
    print("cwhip-pkg: error[PKG0002]: Python 3.11 or newer is required", file=sys.stderr)
    raise SystemExit(2)

import tomllib


STDLIB_DIRECTORY = (
    Path(__file__).resolve().parent / "@CWHIP_PKG_STDLIB_RELATIVE_PATH@"
).resolve()
PREFIX_STDLIB_RELATIVE_PATH = Path("@CWHIP_PKG_PREFIX_STDLIB_RELATIVE_PATH@")
SDK_PREFIX = (Path(__file__).resolve().parent / "@CWHIP_PKG_PREFIX_RELATIVE_PATH@").resolve()
TEMPLATE_MAX_DOWNLOAD = 32 * 1024 * 1024
TEMPLATE_MAX_SIZE = 128 * 1024 * 1024
TEMPLATE_MAX_ENTRIES = 10000
SDK_ABI = "numeric-v2"
VERSION_PATTERN = re.compile(
    r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?"
    r"(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?\Z"
)
IDENTIFIER_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
ENVIRONMENT_NAME_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
CWHIP_KEYWORDS = {
    "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64",
    "fp32", "fp64",
    "start", "int", "bool", "float", "unsigned", "strg", "list", "dict",
    "buffer", "handle", "range", "any", "type", "if", "else", "while", "do", "for",
    "in", "is", "break", "continue", "and", "or", "not", "print", "raise",
    "try", "except", "finally", "class", "namespace", "include", "inline",
    "import", "as", "from", "public", "protected", "private", "virtual",
    "super", "null", "true", "false", "return", "void",
}


class CwhipkgError(Exception):
    """An actionable package-manager error."""

    def __init__(self, message: str, *, code: str = "PKG1001") -> None:
        super().__init__(message)
        self.code = code


def report_error(code: str, message: str) -> None:
    print(f"cwhip-pkg: error[{code}]: {message}", file=sys.stderr)


class DiagnosticArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        report_error("PKG0001", message)
        self.print_usage(sys.stderr)
        self.exit(2)


def valid_identifier(value: object) -> bool:
    return (
        isinstance(value, str)
        and IDENTIFIER_PATTERN.fullmatch(value) is not None
        and value.lower() not in CWHIP_KEYWORDS
    )


def version_parts(version: str) -> tuple[list[str], list[str] | None]:
    match = VERSION_PATTERN.fullmatch(version)
    if match is None:
        raise CwhipkgError(f"invalid SemVer version {version!r}")
    prerelease = match.group(4)
    if prerelease is not None:
        identifiers = prerelease.split(".")
        if any(
            part.isdigit() and len(part) > 1 and part.startswith("0")
            for part in identifiers
        ):
            raise CwhipkgError(f"invalid SemVer prerelease in {version!r}")
    return match.group(1, 2, 3), prerelease.split(".") if prerelease else None


def compare_versions(left: str, right: str) -> int:
    left_core, left_pre = version_parts(left)
    right_core, right_pre = version_parts(right)
    left_numeric = [int(part) for part in left_core]
    right_numeric = [int(part) for part in right_core]
    if left_numeric != right_numeric:
        return (left_numeric > right_numeric) - (left_numeric < right_numeric)
    if left_pre is None:
        return 0 if right_pre is None else 1
    if right_pre is None:
        return -1
    for lhs, rhs in zip(left_pre, right_pre):
        if lhs == rhs:
            continue
        lhs_numeric = lhs.isdigit()
        rhs_numeric = rhs.isdigit()
        if lhs_numeric and rhs_numeric:
            return (int(lhs) > int(rhs)) - (int(lhs) < int(rhs))
        if lhs_numeric != rhs_numeric:
            return -1 if lhs_numeric else 1
        return (lhs > rhs) - (lhs < rhs)
    return (len(left_pre) > len(right_pre)) - (len(left_pre) < len(right_pre))


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as handle:
            parsed = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise CwhipkgError(f"cannot read TOML file {path}: {error}") from error
    return parsed


def require_string(table: dict, key: str, context: str) -> str:
    value = table.get(key)
    if not isinstance(value, str) or not value:
        raise CwhipkgError(f"{context}: required value {key!r} must be a non-empty string")
    return value


def validate_package_source(package_root: Path, source: str, manifest_path: Path) -> Path:
    relative = PurePosixPath(source)
    if relative.is_absolute() or ".." in relative.parts or not relative.parts:
        raise CwhipkgError(f"{manifest_path}: package source must be a relative path without '..'")
    source_path = package_root.joinpath(*relative.parts)
    try:
        resolved_root = package_root.resolve(strict=True)
        resolved_source = source_path.resolve(strict=True)
    except OSError as error:
        raise CwhipkgError(f"{manifest_path}: package source does not exist: {source!r}") from error
    if not resolved_source.is_relative_to(resolved_root) or not resolved_source.is_file():
        raise CwhipkgError(
            f"{manifest_path}: package source must be a file inside {package_root}"
        )
    return resolved_source


def read_manifest(package_root: Path, *, check_directory_version: bool = True) -> dict:
    manifest_path = package_root / "cwhip-package.toml"
    document = read_toml(manifest_path)
    allowed_tables = {"package", "dependencies", "link", "sources"}
    if set(document) - allowed_tables:
        raise CwhipkgError(f"{manifest_path}: unknown top-level manifest table")
    package = document.get("package")
    if not isinstance(package, dict):
        raise CwhipkgError(f"{manifest_path}: missing [package] table")
    if package.get("sdk-abi") != SDK_ABI:
        raise CwhipkgError(
            f'{manifest_path}: incompatible package SDK ABI (expected {SDK_ABI!r}); '
            'migrate source and rebuild native artifacts, then set '
            f'[package] sdk-abi = "{SDK_ABI}"', code="PKG2004"
        )
    if set(package) != {"name", "version", "source", "export", "sdk-abi"}:
        raise CwhipkgError(
            f"{manifest_path}: [package] must contain only name, version, source, export, and sdk-abi"
        )

    name = require_string(package, "name", str(manifest_path))
    version = require_string(package, "version", str(manifest_path))
    source = require_string(package, "source", str(manifest_path))
    exported = require_string(package, "export", str(manifest_path))
    if not valid_identifier(name):
        raise CwhipkgError(f"{manifest_path}: package name must be a Cwhip identifier")
    version_parts(version)
    validate_package_source(package_root, source, manifest_path)
    if check_directory_version and package_root.name != version:
        raise CwhipkgError(
            f"{manifest_path}: version {version!r} does not match directory "
            f"{package_root.name!r}"
        )
    export_parts = exported.split(":")
    if len(export_parts) != 2 or export_parts[0] not in {"class", "namespace"} or not valid_identifier(export_parts[1]):
        raise CwhipkgError(
            f"{manifest_path}: export must be class:Name or namespace:Name"
        )

    dependencies = document.get("dependencies", {})
    if not isinstance(dependencies, dict):
        raise CwhipkgError(f"{manifest_path}: [dependencies] must be a table")
    parsed_dependencies: dict[str, str] = {}
    for dependency, constraint in dependencies.items():
        if not valid_identifier(dependency):
            raise CwhipkgError(f"{manifest_path}: invalid dependency name {dependency!r}")
        if not isinstance(constraint, str) or not constraint.startswith("="):
            raise CwhipkgError(
                f"{manifest_path}: dependency {dependency!r} must use an exact =VERSION pin"
            )
        dependency_version = constraint[1:]
        version_parts(dependency_version)
        parsed_dependencies[dependency] = dependency_version

    sources = read_sources(document.get("sources", {}), str(manifest_path))

    link = document.get("link", {})
    if not isinstance(link, dict) or set(link) - {"libraries", "library-paths"}:
        raise CwhipkgError(f"{manifest_path}: invalid [link] table")
    for key, value in link.items():
        if not isinstance(value, list) or any(not isinstance(item, str) or not item for item in value):
            raise CwhipkgError(f"{manifest_path}: [link] {key} must be an array of strings")
    for library_path in link.get("library-paths", []):
        relative = PurePosixPath(library_path)
        if relative.is_absolute() or ".." in relative.parts:
            raise CwhipkgError(f"{manifest_path}: library paths must be relative and cannot contain '..'")

    return {
        "name": name,
        "version": version,
        "source": source,
        "export": exported,
        "dependencies": parsed_dependencies,
        "sources": sources,
    }


def quote_toml_string(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render_policy(versions: dict[str, list[str]], *, include_string_note: bool = False) -> str:
    lines: list[str] = []
    if include_string_note:
        lines.extend(
            [
                "# String is provided by the compiler builtin/runtime and is available by default.",
                "# It is not an ordinary imported module and does not belong in [modules].",
            ]
        )
    lines.append("[modules]")
    lines.extend(
        f"{name} = [{', '.join(quote_toml_string(version) for version in values)}]"
        for name, values in versions.items()
    )
    return "\n".join(lines) + "\n"


def standard_modules_directory() -> Path:
    configured = os.environ.get("CWHIP_STDLIB_MODULE_DIR")
    if configured:
        return Path(configured).expanduser().resolve()
    prefix = os.environ.get("CWHIP_HOME")
    if prefix:
        return (Path(prefix).expanduser() / PREFIX_STDLIB_RELATIVE_PATH).resolve()
    return STDLIB_DIRECTORY


def user_modules_directory() -> Path | None:
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if config_home:
        root = Path(config_home).expanduser()
        if not root.is_absolute():
            raise CwhipkgError("XDG_CONFIG_HOME must be an absolute path")
    else:
        home = os.environ.get("HOME")
        if not home:
            return None
        root = Path(home).expanduser() / ".config"
    return root / "cwhip" / "modules"


def discover_standard_modules(root: Path) -> dict[str, list[str]]:
    if not root.is_dir():
        raise CwhipkgError(
            f"standard packages are missing from {root}; check the SDK prefix "
            "(CWHIP_HOME) or CWHIP_STDLIB_MODULE_DIR",
            code="PKG2001",
        )
    modules: dict[str, list[str]] = {}
    for package_dir in sorted(root.iterdir()):
        if not package_dir.is_dir():
            continue
        package_versions: list[str] = []
        for version_dir in sorted(package_dir.iterdir()):
            if not version_dir.is_dir() or not (version_dir / "cwhip-package.toml").is_file():
                continue
            try:
                manifest = read_manifest(version_dir)
            except CwhipkgError as error:
                if error.code != "PKG2004":
                    raise
                raise CwhipkgError(
                    f"{error}. This package is installed in the SDK package directory {root}, "
                    "which a Cwhip SDK reinstall does not replace: reinstall the package from a "
                    "source version built for this SDK, remove it if unused, or rerun the SDK "
                    "install with CWHIP_QUARANTINE_INCOMPATIBLE_PACKAGES=1 to move incompatible "
                    "packages to a backup", code="PKG2004") from error
            if manifest["name"] != package_dir.name:
                raise CwhipkgError(
                    f"{version_dir / 'cwhip-package.toml'}: package name does not match "
                    f"directory {package_dir.name!r}"
                )
            package_versions.append(manifest["version"])
        if package_versions:
            modules[package_dir.name] = sorted(
                set(package_versions),
                key=functools.cmp_to_key(compare_versions),
                reverse=True,
            )
    return modules


def find_project(start: Path) -> Path:
    start = start.resolve()
    for candidate in (start, *start.parents):
        legacy = candidate / "modules/modules.toml"
        if legacy.exists():
            raise CwhipkgError(
                f"{legacy}: legacy modules.toml is not imported or modified; "
                "create a separate project with 'cwhip-pkg init' and declare dependencies manually"
            )
        if (candidate / "cwhip-pkg.toml").exists() or (candidate / "modules").is_dir():
            return candidate
    return start


def command_init(project_directory: str | None) -> None:
    project = find_project(Path(project_directory or Path.cwd()))
    for path in (project / "cwhip-pkg.toml", project / "cwhip-pkg.lock"):
        if path.exists() or path.is_symlink():
            raise CwhipkgError(f"refusing to overwrite existing configuration: {path}")
    project.mkdir(parents=True, exist_ok=True)
    content = render_project({"dependencies": {}, "sources": {}})
    packages = builtin_packages()
    validate_graph(packages, {"dependencies": {}, "sources": {}})
    persist(project, packages, {}, content)
    print(f"Initialized Cwhip project in {project}")


def parse_github_repository(value: str) -> tuple[str, str, str]:
    match = re.fullmatch(r"([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)", value)
    if match is None or match.group(1) in {".", ".."} or match.group(2) in {".", ".."}:
        raise CwhipkgError("repository must be written as OWNER/REPO")
    owner, repository = match.groups()
    return owner, repository, f"https://github.com/{owner}/{repository}.git"


def run_git(arguments: list[str], *, error_context: str) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            ["git", "-c", "core.hooksPath=/dev/null", "-c", "color.ui=false", *arguments],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env={**os.environ, "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": os.devnull},
        )
    except FileNotFoundError as error:
        raise CwhipkgError(
            "git is required; install git and ensure it is on PATH", code="PKG3001"
        ) from error
    except subprocess.CalledProcessError as error:
        details = "".join(
            f"\n{stream}" for stream in (error.stdout, error.stderr) if stream
        )
        raise CwhipkgError(
            f"{error_context} (git exit status {error.returncode}){details}",
            code="PKG3001",
        ) from error
    return result


def stable_remote_versions(remote: str) -> list[str]:
    result = run_git(
        ["ls-remote", "--tags", "--refs", remote],
        error_context=f"could not list tags for {remote}",
    )
    versions: set[str] = set()
    for line in result.stdout.splitlines():
        fields = line.split("\t", maxsplit=1)
        if len(fields) != 2 or not fields[1].startswith("refs/tags/"):
            continue
        tag = fields[1][len("refs/tags/") :]
        try:
            _, prerelease = version_parts(tag)
        except CwhipkgError:
            continue
        if prerelease is None:
            versions.add(tag)
    if not versions:
        raise CwhipkgError(
            f"{remote} has no stable SemVer tags; add a version tag such as 1.2.3"
        )
    return sorted(
        versions,
        key=functools.cmp_to_key(compare_versions),
        reverse=True,
    )


def read_sources(value: object, context: str) -> dict[str, str]:
    if not isinstance(value, dict):
        raise CwhipkgError(f"{context}: [sources] must be a table")
    for name, repository in value.items():
        if not valid_identifier(name) or not isinstance(repository, str):
            raise CwhipkgError(f"{context}: invalid source mapping {name!r}")
        parse_github_repository(repository)
    return dict(value)


def read_project(project: Path) -> dict:
    path = project / "cwhip-pkg.toml"
    document = read_toml(path)
    if type(document.get("schema")) is not int or document["schema"] != 1:
        raise CwhipkgError(f"{path}: unsupported manifest schema (expected 1)")
    if set(document) - {"schema", "dependencies", "sources"}:
        raise CwhipkgError(f"{path}: unknown manifest field")
    dependencies = document.get("dependencies", {})
    if not isinstance(dependencies, dict):
        raise CwhipkgError(f"{path}: [dependencies] must be a table")
    sources = read_sources(document.get("sources", {}), str(path))
    for name, entry in dependencies.items():
        if not valid_identifier(name) or not isinstance(entry, dict) or set(entry) != {"repo", "version"}:
            raise CwhipkgError(f"{path}: invalid dependency {name!r}")
        parse_github_repository(require_string(entry, "repo", str(path)))
        exact = require_string(entry, "version", str(path))
        if not exact.startswith("="):
            raise CwhipkgError(f"{path}: dependency {name!r} must use an exact =VERSION pin")
        version_parts(exact[1:])
        if name in sources and sources[name] != entry["repo"]:
            raise CwhipkgError(f"{path}: repository conflict for {name}")
    return {"dependencies": dependencies, "sources": sources}


def render_project(document: dict) -> str:
    lines = ["# Lock fingerprint is SHA-256 of these exact file bytes.", "schema = 1", ""]
    for name, entry in sorted(document["dependencies"].items()):
        lines.extend([
            f"[dependencies.{name}]",
            f"repo = {quote_toml_string(entry['repo'])}",
            f"version = {quote_toml_string(entry['version'])}", "",
        ])
    lines.append("[sources]")
    lines.extend(f"{name} = {quote_toml_string(repo)}" for name, repo in sorted(document["sources"].items()))
    return "\n".join(lines) + "\n"


def tree_digest(root: Path) -> str:
    """SHA-256 of sorted UTF-8 paths + NUL + file bytes + NUL.

    Directories/modes are not hashed. Symlinks, special files and .git entries
    are rejected, including empty directories containing forbidden entries.
    """
    if root.is_symlink() or not root.is_dir():
        raise CwhipkgError(f"unsafe package directory: {root}")
    digest = hashlib.sha256()
    files = []
    for directory, directories, filenames in os.walk(root, followlinks=False):
        for name in directories + filenames:
            path = Path(directory) / name
            mode = path.lstat().st_mode
            if name == ".git" or stat.S_ISLNK(mode) or not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
                raise CwhipkgError(f"unsafe package entry (symlink, special file or .git): {path}")
            if stat.S_ISREG(mode):
                files.append(path)
    for path in sorted(files, key=lambda item: item.relative_to(root).as_posix()):
        name = path.relative_to(root).as_posix().encode("utf-8")
        content = path.read_bytes()
        digest.update(name)
        digest.update(b"\0")
        digest.update(content)
        digest.update(b"\0")
    return digest.hexdigest()


def package_record(manifest: dict, repo: str, commit: str, digest: str) -> dict:
    version = manifest["version"]
    return {
        "repo": repo, "version": version,
        "ref": "builtin" if repo == "builtin" else f"refs/tags/{version}",
        "commit": commit, "sha256": digest,
        "dependencies": [f"{name}={value}" for name, value in sorted(manifest["dependencies"].items())],
    }


def builtin_packages() -> dict:
    packages = {}
    standard_modules = standard_modules_directory()
    for name, versions in discover_standard_modules(standard_modules).items():
        stable = [version for version in versions if version_parts(version)[1] is None]
        if not stable:
            raise CwhipkgError(f"bundled module {name} has no stable SemVer version")
        version = stable[0]
        root = standard_modules / name / version
        packages[name] = package_record(read_manifest(root), "builtin", "builtin", tree_digest(root))
    return packages


def package_name(key: str) -> str:
    return key


def locked_modules(packages: dict) -> dict[str, list[str]]:
    modules: dict[str, list[str]] = {}
    for key, entry in sorted(packages.items()):
        modules.setdefault(package_name(key), []).append(entry["version"])
    for versions in modules.values():
        versions.sort(key=functools.cmp_to_key(compare_versions), reverse=True)
    return modules


def render_lock(packages: dict, manifest: bytes) -> str:
    lines = [
        "schema = 1",
        f'manifest-sha256 = "{hashlib.sha256(manifest).hexdigest()}"', "",
        render_policy(locked_modules(packages)).rstrip(), "",
    ]
    for name, entry in sorted(packages.items()):
        lines.append(f"[packages.{name}]")
        for field in ("repo", "version", "ref", "commit", "sha256"):
            lines.append(f"{field} = {quote_toml_string(entry[field])}")
        lines.append("dependencies = [" + ", ".join(quote_toml_string(dep) for dep in entry["dependencies"]) + "]")
        lines.append("")
    return "\n".join(lines)


def validate_graph(packages: dict, document: dict) -> None:
    identities = {(package_name(key), entry["version"]): entry for key, entry in packages.items()}
    sources = dict(document["sources"])
    for name, entry in document["dependencies"].items():
        sources[name] = entry["repo"]
        selected = identities.get((name, entry["version"][1:]))
        if selected is None or selected["repo"] != entry["repo"]:
            raise CwhipkgError(f"lock does not satisfy direct dependency {name}")
    for key, entry in packages.items():
        name = package_name(key)
        if name in sources and sources[name] != entry["repo"]:
            raise CwhipkgError(f"repository conflict for {name}")
    active, done = set(), set()

    def visit(identity: tuple[str, str]) -> None:
        if identity in active:
            raise CwhipkgError(f"dependency cycle at {identity[0]}={identity[1]}")
        if identity in done:
            return
        active.add(identity)
        for dependency in identities[identity]["dependencies"]:
            name, version = dependency.split("=", 1)
            child = (name, version)
            if child not in identities:
                raise CwhipkgError(f"lock is missing dependency {dependency}")
            visit(child)
        active.remove(identity)
        done.add(identity)

    for identity in identities:
        visit(identity)
    reachable = set()

    def mark(identity: tuple[str, str]) -> None:
        if identity in reachable:
            return
        reachable.add(identity)
        for dep in identities[identity]["dependencies"]:
            name, version = dep.split("=", 1)
            mark((name, version))

    for identity, entry in identities.items():
        if entry["repo"] == "builtin":
            mark(identity)
    for name, entry in document["dependencies"].items():
        mark((name, entry["version"][1:]))
    if reachable != set(identities):
        raise CwhipkgError("lock contains packages not reachable from manifest or bundled modules")


def read_lock(project: Path, document: dict) -> dict:
    path = project / "cwhip-pkg.lock"
    lock = read_toml(path)
    if type(lock.get("schema")) is not int or lock["schema"] != 1:
        raise CwhipkgError(f"{path}: unsupported lock schema (expected 1)")
    if set(lock) != {"schema", "manifest-sha256", "modules", "packages"}:
        raise CwhipkgError(f"{path}: invalid lock fields")
    if lock["manifest-sha256"] != hashlib.sha256((project / "cwhip-pkg.toml").read_bytes()).hexdigest():
        raise CwhipkgError(f"{path}: stale lock; manifest-sha256 does not match cwhip-pkg.toml")
    packages = lock["packages"]
    if not isinstance(packages, dict) or not isinstance(lock["modules"], dict):
        raise CwhipkgError(f"{path}: invalid lock tables")
    identities = set()
    for key, entry in packages.items():
        name = package_name(key)
        if not valid_identifier(name) or not isinstance(entry, dict) or set(entry) != {
            "repo", "version", "ref", "commit", "sha256", "dependencies"
        }:
            raise CwhipkgError(f"{path}: invalid locked package {key!r}")
        for field in ("repo", "version", "ref", "commit", "sha256"):
            require_string(entry, field, str(path))
        version_parts(entry["version"])
        identity = (name, entry["version"])
        if identity in identities:
            raise CwhipkgError(f"{path}: duplicate package identity {name}")
        identities.add(identity)
        if entry["repo"] != "builtin":
            parse_github_repository(entry["repo"])
            if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", entry["commit"]):
                raise CwhipkgError(f"{path}: invalid commit for {name}")
        if entry["ref"] != ("builtin" if entry["repo"] == "builtin" else f"refs/tags/{entry['version']}"):
            raise CwhipkgError(f"{path}: invalid ref for {name}")
        if not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]):
            raise CwhipkgError(f"{path}: invalid sha256 for {name}")
        dependencies = entry["dependencies"]
        if not isinstance(dependencies, list) or any(not isinstance(dep, str) or "=" not in dep for dep in dependencies):
            raise CwhipkgError(f"{path}: invalid dependencies for {name}")
        names = set()
        for dep in dependencies:
            dependency, version = dep.split("=", 1)
            if not valid_identifier(dependency) or dependency in names:
                raise CwhipkgError(f"{path}: invalid dependency {dep}")
            names.add(dependency)
            version_parts(version)
    if lock["modules"] != locked_modules(packages):
        raise CwhipkgError(f"{path}: modules do not match locked packages")
    if any(len(versions) != 1 for versions in lock["modules"].values()):
        raise CwhipkgError(f"{path}: conflicting package versions")
    validate_graph(packages, document)
    return packages


def consent(yes: bool, dry_run: bool) -> bool:
    if yes:
        return True
    if dry_run:
        print("Initial plan only; use --dry-run --yes to consent to network graph resolution.")
        return False
    if sys.stdin.isatty():
        answer = input("Allow network access for declared repositories and package installation? [y/N] ")
        if answer.lower() in {"y", "yes"}:
            return True
    raise CwhipkgError("network consent required; review the plan, then pass --yes (or --dry-run for an offline initial plan)")


def checkout_package(repo: str, version: str, workspace: Path, index: int, *, commit: str | None = None) -> tuple[dict, Path, str]:
    _, _, remote = parse_github_repository(repo)
    print(f"Fetch {repo} at {commit or 'refs/tags/' + version}", flush=True)
    checkout = workspace / str(index)
    run_git(["clone", "--quiet", "--no-checkout", remote, str(checkout)], error_context=f"could not clone {repo}")
    reference = commit or f"refs/tags/{version}"
    if commit is not None:
        run_git(["-C", str(checkout), "fetch", "--quiet", "origin", commit],
                error_context=f"could not fetch locked commit {commit} from {repo}")
    run_git(["-C", str(checkout), "checkout", "--quiet", "--detach", reference], error_context=f"could not check out {reference} from {repo}")
    actual_commit = run_git(["-C", str(checkout), "rev-parse", "HEAD"], error_context="could not resolve commit").stdout.strip()
    if commit is not None and actual_commit != commit:
        raise CwhipkgError(f"commit mismatch for {repo}")
    shutil.rmtree(checkout / ".git")
    tree_digest(checkout)
    manifest = read_manifest(checkout, check_directory_version=False)
    if manifest["version"] != version:
        raise CwhipkgError(f"{checkout / 'cwhip-package.toml'}: selected version {version} does not match manifest {manifest['version']}")
    return manifest, checkout, actual_commit


def resolve_graph(document: dict, workspace: Path, *, seed: tuple[str, dict, Path, str] | None = None, yes: bool = False) -> tuple[dict, dict]:
    packages = builtin_packages()
    staged = {}
    sources = dict(document["sources"])
    sources.update({name: entry["repo"] for name, entry in document["dependencies"].items()})
    approved_repositories = set(sources.values())
    active, done = set(), set()
    selected = {}

    def visit(name: str, version: str, repo: str | None, fetched=None) -> None:
        prior = selected.get(name)
        if prior is not None and prior != (version, repo):
            raise CwhipkgError(f"exact version or repository conflict for {name}: {prior} versus {(version, repo)}")
        selected[name] = (version, repo)
        if name in active:
            raise CwhipkgError(f"dependency cycle at {name}")
        if name in done:
            return
        builtin = next((entry for key, entry in packages.items() if package_name(key) == name and entry["version"] == version), None)
        if builtin:
            if repo is not None:
                raise CwhipkgError(f"repository conflict for bundled module {name}")
            manifest = read_manifest(standard_modules_directory() / name / version)
        else:
            if any(package_name(key) == name for key in packages):
                raise CwhipkgError(f"exact version conflict for bundled module {name}")
            if repo is None:
                raise CwhipkgError(f"unmapped dependency {name}={version}; declare its repository in [sources] before fetching")
            if repo not in approved_repositories:
                print(f"Transitive source plan: {name}={version} from declared repository {repo}", flush=True)
                if not yes:
                    answer = input(f"Allow network access to {repo}? [y/N] ") if sys.stdin.isatty() else ""
                    if answer.lower() not in {"y", "yes"}:
                        raise CwhipkgError(f"explicit network consent required for transitive repository {repo}")
                approved_repositories.add(repo)
            manifest, root, commit = fetched or checkout_package(repo, version, workspace, len(staged))
            if manifest["name"] != name:
                raise CwhipkgError(f"repository {repo} declares {manifest['name']}, expected {name}")
            packages[name] = package_record(manifest, repo, commit, tree_digest(root))
            staged[name] = root
        for dep, source_repo in sorted(manifest["sources"].items()):
            if dep in sources and sources[dep] != source_repo:
                raise CwhipkgError(f"repository conflict for {dep}")
            sources[dep] = source_repo
        active.add(name)
        for dependency, required in sorted(manifest["dependencies"].items()):
            visit(dependency, required, sources.get(dependency))
        active.remove(name)
        done.add(name)

    for name, entry in sorted(document["dependencies"].items()):
        fetched = seed[1:] if seed and seed[0] == name else None
        visit(name, entry["version"][1:], entry["repo"], fetched)
    # Selected bundled versions are pinned; incompatible exact edges are conflicts.
    for key, entry in list(packages.items()):
        if entry["repo"] == "builtin":
            for dep in entry["dependencies"]:
                name, version = dep.split("=", 1)
                visit(name, version, sources.get(name))
    validate_graph(packages, document)
    return packages, staged


def plan(packages: dict) -> None:
    print("Resolved graph:")
    for key, entry in sorted(packages.items()):
        print(f"  {package_name(key)}={entry['version']} {entry['repo']} {entry['commit']} sha256={entry['sha256']}")


def atomic_write(path: Path, content: bytes) -> None:
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".cwhip-pkg-write-", delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def check_destination(project: Path, name: str, version: str) -> Path:
    destination = project / "modules" / name / version
    for path in (project / "modules", destination.parent, destination):
        if path.is_symlink():
            raise CwhipkgError(f"unsafe installed package path: {path}")
    return destination


def package_search_roots(project: Path) -> list[Path]:
    roots = [project / "modules"]
    environment_root = os.environ.get("CWHIP_MODULE_DIR")
    if environment_root:
        resolved_environment_root = Path(environment_root).expanduser().resolve()
        if not resolved_environment_root.is_dir():
            raise CwhipkgError(
                f"module directory from CWHIP_MODULE_DIR does not exist or is not a "
                f"directory: {resolved_environment_root}"
            )
        roots.append(resolved_environment_root)
    user_root = user_modules_directory()
    if user_root is not None:
        roots.append(user_root)
    roots.append(standard_modules_directory())
    unique: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        resolved = root.resolve()
        if resolved not in seen:
            seen.add(resolved)
            unique.append(resolved)
    return unique


def verify_package(root: Path, name: str, entry: dict) -> None:
    if tree_digest(root) != entry["sha256"]:
        raise CwhipkgError(f"integrity mismatch at {root}; refusing to overwrite existing content")
    manifest = read_manifest(root, check_directory_version=False)
    if manifest["name"] != name or manifest["version"] != entry["version"] or package_record(
        manifest, entry["repo"], entry["commit"], entry["sha256"]
    ) != entry:
        raise CwhipkgError(f"locked manifest mismatch at {root}")


def inspect_installed(project: Path, packages: dict) -> list[str]:
    missing = []
    roots = package_search_roots(project)
    for key, entry in sorted(packages.items()):
        name = package_name(key)
        selected = None
        selected_versions = []
        for root in roots:
            package_directory = root / name
            if not package_directory.is_dir():
                continue
            versions = sorted(path for path in package_directory.iterdir() if path.is_dir())
            if not versions:
                continue
            for version_directory in versions:
                if version_directory.name == entry["version"]:
                    continue
                manifest = read_manifest(version_directory)
                if manifest["name"] != name:
                    raise CwhipkgError(
                        f"{version_directory / 'cwhip-package.toml'}: package name "
                        f"{manifest['name']!r} does not match directory {name!r}"
                    )
            selected = package_directory / entry["version"]
            break
        if selected is None:
            missing.append(key)
        elif not selected.is_dir():
            missing.append(key)
        else:
            verify_package(selected, name, entry)
    return missing


def persist(project: Path, packages: dict, staged: dict, manifest_content: str | None = None, *, frozen: bool = False) -> None:
    inspect_installed(project, packages)
    created = []
    originals = {}
    try:
        modules = project / "modules"
        if not modules.exists():
            modules.mkdir()
            created.append(modules)
        for key, root in sorted(staged.items()):
            entry = packages[key]
            name = package_name(key)
            destination = check_destination(project, name, entry["version"])
            if destination.exists():
                continue
            if not destination.parent.exists():
                destination.parent.mkdir()
                created.append(destination.parent)
            destination.mkdir()
            created.append(destination)
            shutil.copytree(root, destination, dirs_exist_ok=True)
            verify_package(destination, name, entry)
        if not frozen:
            manifest_path = project / "cwhip-pkg.toml"
            manifest = manifest_content.encode("utf-8") if manifest_content is not None else manifest_path.read_bytes()
            updates = {project / "cwhip-pkg.lock": render_lock(packages, manifest).encode("utf-8")}
            if manifest_content is not None:
                updates = {manifest_path: manifest, **updates}
            for path, content in updates.items():
                if path.is_symlink():
                    raise CwhipkgError(f"unsafe configuration path: {path}")
                originals[path] = path.read_bytes() if path.exists() else None
                atomic_write(path, content)
    except (OSError, CwhipkgError):
        for path, original in originals.items():
            try:
                if original is None:
                    path.unlink(missing_ok=True)
                else:
                    atomic_write(path, original)
            except OSError as error:
                report_error("PKG9001", f"rollback could not restore {path}: {error}")
        for path in reversed(created):
            if path.is_dir():
                if path.name in {entry["version"] for entry in packages.values()}:
                    try:
                        shutil.rmtree(path)
                    except OSError as error:
                        report_error("PKG9001", f"rollback could not remove {path}: {error}")
                else:
                    try:
                        path.rmdir()
                    except OSError:
                        pass
        raise


def command_add(repository: str, version: str | None, yes: bool, dry_run: bool) -> None:
    parse_github_repository(repository)
    if version is not None:
        version_parts(version)
    project = find_project(Path.cwd())
    print(f"Initial plan: add {repository} {version or '(highest stable tag)'}; resolve exact dependencies and install graph.")
    if not (project / "cwhip-pkg.toml").is_file():
        raise CwhipkgError(
            f"no cwhip-pkg.toml found in {project}; run 'cwhip-pkg init' before adding packages"
        )
    document = read_project(project)
    if (project / "cwhip-pkg.lock").exists():
        inspect_installed(project, read_lock(project, document))
    if not consent(yes, dry_run):
        return
    if version is None:
        _, _, remote = parse_github_repository(repository)
        version = stable_remote_versions(remote)[0]
    with tempfile.TemporaryDirectory(prefix=".cwhip-pkg-", dir=project) as scratch:
        workspace = Path(scratch)
        manifest, root, commit = checkout_package(repository, version, workspace, -1)
        name = manifest["name"]
        previous = document["dependencies"].get(name)
        if previous and previous["repo"] != repository:
            raise CwhipkgError(f"repository conflict for {name}")
        if name in document["sources"] and document["sources"][name] != repository:
            raise CwhipkgError(f"repository conflict for {name}")
        document["dependencies"][name] = {"repo": repository, "version": "=" + version}
        packages, staged = resolve_graph(document, workspace, seed=(name, manifest, root, commit), yes=yes)
        plan(packages)
        inspect_installed(project, packages)
        if not dry_run:
            persist(project, packages, staged, render_project(document))
            print(f"Installed graph; direct dependency {name}={version} from {repository}")


def command_install(yes: bool, dry_run: bool) -> None:
    project = find_project(Path.cwd())
    document = read_project(project)
    if (project / "cwhip-pkg.lock").exists():
        packages = read_lock(project, document)
        plan(packages)
        missing = inspect_installed(project, packages)
        if not missing:
            print("Locked graph verified; all packages already installed.")
            return
        print("Initial plan: restore " + ", ".join(missing) + " at locked commits (never moving tags).")
        if not consent(yes, dry_run):
            return
        with tempfile.TemporaryDirectory(prefix=".cwhip-pkg-", dir=project) as scratch:
            staged = {}
            for index, key in enumerate(missing):
                entry = packages[key]
                _, root, _ = checkout_package(entry["repo"], entry["version"], Path(scratch), index, commit=entry["commit"])
                verify_package(root, package_name(key), entry)
                staged[key] = root
            if not dry_run:
                persist(project, packages, staged, frozen=True)
    else:
        print("Initial plan: resolve manifest repositories " + ", ".join(
            sorted(entry["repo"] for entry in document["dependencies"].values())))
        if not consent(yes, dry_run):
            return
        with tempfile.TemporaryDirectory(prefix=".cwhip-pkg-", dir=project) as scratch:
            packages, staged = resolve_graph(document, Path(scratch), yes=yes)
            plan(packages)
            inspect_installed(project, packages)
            if not dry_run:
                persist(project, packages, staged)


def preferences_path(explicit_path: str | None) -> tuple[Path, bool]:
    if explicit_path is not None:
        return Path(explicit_path).expanduser(), True
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if config_home:
        path = Path(config_home).expanduser()
        if not path.is_absolute():
            raise CwhipkgError("XDG_CONFIG_HOME must be an absolute path")
    else:
        home = os.environ.get("HOME")
        if not home:
            raise CwhipkgError("HOME is unset; pass --preferences FILE or set HOME")
        path = Path(home).expanduser() / ".config"
    return path / "cwhip" / "preferences.toml", False


def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"


def command_env(explicit_preferences: str | None) -> None:
    path, explicit = preferences_path(explicit_preferences)
    preferences: dict[str, str] = {}
    if path.exists():
        document = read_toml(path)
        if set(document) - {"environment"}:
            raise CwhipkgError(f"{path}: only the [environment] table is supported")
        environment = document.get("environment", {})
        if not isinstance(environment, dict):
            raise CwhipkgError(f"{path}: [environment] must be a table")
        for name, value in environment.items():
            if ENVIRONMENT_NAME_PATTERN.fullmatch(name) is None:
                raise CwhipkgError(f"{path}: invalid environment variable name {name!r}")
            if not isinstance(value, str):
                raise CwhipkgError(
                    f"{path}: environment value {name!r} must be a string"
                )
            if "\0" in value:
                raise CwhipkgError(f"{path}: environment value {name!r} contains a NUL byte")
            preferences[name] = value
    elif explicit:
        raise CwhipkgError(f"preferences file does not exist: {path}")

    for name, value in preferences.items():
        print(f"export {name}={shell_quote(value)}")


def command_list() -> None:
    project = find_project(Path.cwd())
    if not (project / "cwhip-pkg.toml").is_file():
        raise CwhipkgError(
            f"no cwhip-pkg.toml found in {project}; run 'cwhip-pkg init' to create a locked project"
        )
    document = read_project(project)
    packages = read_lock(project, document)
    missing = inspect_installed(project, packages)
    for key, entry in sorted(packages.items()):
        print(f"{package_name(key)}: locked {entry['version']}; {'not installed' if key in missing else 'installed'}; {entry['repo']}")


def doctor_sdk_prefix() -> tuple[Path, str]:
    override = os.environ.get("CWHIP_SDK")
    if override:
        value, origin = override, "CWHIP_SDK"
    else:
        config_home = os.environ.get("XDG_CONFIG_HOME")
        home = os.environ.get("HOME")
        root = Path(config_home) if config_home else Path(home) / ".config" if home else None
        if root is not None and not root.is_absolute():
            raise CwhipkgError("config home must be absolute; set XDG_CONFIG_HOME or HOME to an absolute path",
                               code="PKG2003")
        settings = root / "cwhip/sdk.toml" if root else None
        document = {}
        if settings is not None:
            for candidate in (settings, root / "cwhip/settings.toml"):
                try:
                    with candidate.open("rb") as stream:
                        document = tomllib.load(stream)
                except FileNotFoundError:
                    # A dangling symlink is a broken selection, not an absent file.
                    if not candidate.is_symlink():
                        continue
                    raise CwhipkgError(f"cannot read SDK configuration {candidate}: dangling symlink; repair it or set CWHIP_SDK",
                                       code="PKG2003")
                except (OSError, ValueError) as error:
                    raise CwhipkgError(f"cannot read SDK configuration {candidate}: {error}; repair it or set CWHIP_SDK",
                                       code="PKG2003") from error
                settings = candidate
                break
        if "sdk_prefix" not in document:
            return SDK_PREFIX, "prefix beside cwhip-pkg (no SDK override/setting)"
        value, origin = document["sdk_prefix"], str(settings)
    if (not isinstance(value, str) or not value or any(c in value for c in "\0\r\n")
            or not Path(value).is_absolute() or not Path(value).is_dir()):
        raise CwhipkgError(f"{origin}: SDK prefix must be an absolute existing directory without NUL or line breaks; select a complete SDK",
                           code="PKG2003")
    return Path(value), origin


def doctor_probe(command: list[str]) -> tuple[bool, str]:
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False,
                                stdin=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        return False, str(error)
    detail = (result.stdout + result.stderr).strip()
    return result.returncode == 0, f"exit {result.returncode}: {detail}"


def command_doctor() -> None:
    failed = False

    def check(label: str, passed: bool, detail: str, remedy: str, *, optional: bool = False) -> None:
        nonlocal failed
        status = "PASS" if passed else "WARN" if optional else "FAIL"
        print(f"{status} {'optional' if optional else 'required'} {label}: {detail}")
        if not passed:
            print(f"  Remedy: {remedy}")
            failed = failed or not optional

    check("Python >=3.11", sys.version_info >= (3, 11), sys.version.split()[0],
          "install Python 3.11 or newer")
    try:
        prefix, origin = doctor_sdk_prefix()
    except CwhipkgError as error:
        check("SDK selection", False, str(error), "repair the selected SDK configuration file or set CWHIP_SDK")
        report_error(error.code, str(error))
    else:
        check("SDK prefix", prefix.is_dir(), f"{prefix} ({origin})",
              "build/install the complete SDK or set CWHIP_SDK")
        resources = {
            "compiler": prefix / "@CWHIP_RELATIVE_BINDIR@/cwhip",
            "runtime": prefix / "@CWHIP_RELATIVE_LIBDIR@/cwhip/libcwhip_runtime.a",
            "runtime header": prefix / "@CWHIP_RELATIVE_INCLUDEDIR@/cwhip/Stdlib.h",
            "GC header": prefix / "@CWHIP_RELATIVE_INCLUDEDIR@/cwhip/RuntimeGc.h",
            "String builtin": prefix / "@CWHIP_RELATIVE_DATADIR@/cwhip/builtin/String.cw",
            "CMake config": prefix / "@CWHIP_RELATIVE_LIBDIR@/cmake/Cwhip/CwhipConfig.cmake",
            "CMake version": prefix / "@CWHIP_RELATIVE_LIBDIR@/cmake/Cwhip/CwhipConfigVersion.cmake",
            "CMake application helper": prefix / "@CWHIP_RELATIVE_LIBDIR@/cmake/Cwhip/CwhipApplication.cmake",
            "CMake staging helper": prefix / "@CWHIP_RELATIVE_LIBDIR@/cmake/Cwhip/CwhipStageSources.cmake",
        }
        for label, path in resources.items():
            present = path.is_file() and os.access(path, os.R_OK)
            if label == "compiler":
                present = present and os.access(path, os.X_OK)
            check(label, present, str(path), "build and install the complete SDK into this prefix")
        passed, detail = doctor_probe([str(resources["compiler"]), "--version"])
        check("compiler startup", passed and detail.startswith("exit 0: cwhip: v"), detail,
              "rebuild/install a working Cwhip compiler")
        modules = prefix / PREFIX_STDLIB_RELATIVE_PATH
        try:
            packages = discover_standard_modules(modules)
            required = {"math", "networking", "process", "random", "sql", "sqlite",
                        "synchronization", "system", "terminal", "time"}
            missing = sorted(required - packages.keys())
            check("bundled standard packages", not missing, f"{modules}; missing: {', '.join(missing) or 'none'}",
                  "reinstall the SDK's standard packages")
        except (CwhipkgError, OSError) as error:
            remedy = "reinstall the SDK's standard packages"
            if isinstance(error, CwhipkgError) and error.code == "PKG2004":
                remedy = ("reinstall or remove the incompatible package, or rerun the SDK install "
                          "with CWHIP_QUARANTINE_INCOMPATIBLE_PACKAGES=1")
            check("bundled standard packages", False, f"{modules}: {error}", remedy)
    selected = os.environ.get("CC") or "@CWHIP_CLANG_EXECUTABLE@"
    if not os.environ.get("CC") and shutil.which(selected) is None:
        print(f"NOTE configured Clang {selected} unavailable; selecting clang via PATH")
        selected = "clang"
    for label, command, remedy in (
        ("Clang/CC", [selected, "--version"], "install Clang or set CC to a Clang driver executable"),
        ("git", ["git", "--version"], "install git for package installation"),
        ("CMake >=3.24", ["cmake", "--version"], "install CMake 3.24 or newer for template projects"),
    ):
        passed, detail = doctor_probe(command)
        if label == "Clang/CC":
            passed = passed and "clang" in detail.lower()
        if label.startswith("CMake"):
            match = re.search(r"cmake version (\d+)\.(\d+)", detail)
            passed = passed and match is not None and tuple(map(int, match.groups())) >= (3, 24)
        check(label, passed, f"{command[0]}: {detail}", remedy)
    for package, version in (("gtk4", "4.10"), ("gtksourceview-5", "5")):
        passed, detail = doctor_probe(["pkg-config", "--print-errors", f"--atleast-version={version}", package])
        check(package, passed, f">={version}; {detail}",
              f"install pkg-config and {package} development files for optional GUI app development",
              optional=True)
    if failed:
        raise CwhipkgError("required doctor checks failed; see stdout for checks and remedies", code="PKG2002")


def template_path(name: str) -> PurePosixPath:
    path = PurePosixPath(name)
    if (path.is_absolute() or ".." in path.parts or "\\" in name
            or "\0" in name or (path.parts and ":" in path.parts[0])):
        raise CwhipkgError(f"unsafe template path {name!r}", code="PKG1005")
    return path


def unpack_template(source: Path, output: Path) -> None:
    count = total = 0

    def copy_entry(name: str, size: int, directory: bool, stream, mode: int) -> None:
        nonlocal count, total
        path = template_path(name)
        count += 1
        total += size
        if count > TEMPLATE_MAX_ENTRIES or size < 0 or total > TEMPLATE_MAX_SIZE:
            raise CwhipkgError("template exceeds entry or expanded-size limit", code="PKG1005")
        if ".git" in path.parts:
            return
        target = output.joinpath(*path.parts)
        if directory:
            target.mkdir(parents=True, exist_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open("xb") as destination:
                remaining = size
                while chunk := stream.read(min(64 * 1024, remaining + 1)):
                    remaining -= len(chunk)
                    if remaining < 0:
                        raise CwhipkgError(f"template entry grew beyond declared size: {name}", code="PKG1005")
                    destination.write(chunk)
                if remaining:
                    raise CwhipkgError(f"truncated template entry: {name}", code="PKG1005")
            target.chmod(0o755 if mode & 0o111 else 0o644)

    try:
        if source.is_dir():
            def walk_error(error: OSError) -> None:
                raise error

            for root, directories, files in os.walk(source, followlinks=False, onerror=walk_error):
                directories[:] = [name for name in directories if name != ".git"]
                for name in directories + files:
                    path = Path(root) / name
                    info = path.lstat()
                    if not stat.S_ISREG(info.st_mode) and not stat.S_ISDIR(info.st_mode):
                        raise CwhipkgError(f"template links/special files are not allowed: {path}", code="PKG1005")
                    relative = path.relative_to(source).as_posix()
                    if path.is_dir():
                        copy_entry(relative, 0, True, None, info.st_mode)
                    else:
                        with path.open("rb") as stream:
                            copy_entry(relative, info.st_size, False, stream, info.st_mode)
        elif zipfile.is_zipfile(source):
            with zipfile.ZipFile(source) as archive:
                for entry in archive.infolist():
                    mode = entry.external_attr >> 16
                    if stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR):
                        raise CwhipkgError(f"template links/special files are not allowed: {entry.filename}", code="PKG1005")
                    with archive.open(entry) as stream:
                        copy_entry(entry.filename, entry.file_size, entry.is_dir(), stream, mode)
        else:
            with tarfile.open(source, "r:*") as archive:
                for entry in archive:
                    if entry.isdir():
                        copy_entry(entry.name, 0, True, None, entry.mode)
                    elif entry.isfile():
                        with archive.extractfile(entry) as stream:
                            copy_entry(entry.name, entry.size, False, stream, entry.mode)
                    else:
                        raise CwhipkgError(f"template links/special files are not allowed: {entry.name}", code="PKG1005")
    except (tarfile.TarError, zipfile.BadZipFile, zlib.error, RuntimeError, EOFError, OSError) as error:
        raise CwhipkgError(f"cannot unpack template {source}: {error}", code="PKG1005") from error


def rename_template(root: Path, name: str) -> None:
    cmake = root / "CMakeLists.txt"
    main_source = root / "src/main.cw"
    if not cmake.is_file() or not main_source.is_file():
        raise CwhipkgError("template must contain CMakeLists.txt and src/main.cw", code="PKG1005")
    cmake_text = cmake.read_text(encoding="utf-8")
    if not re.search(r"\bproject\s*\(\s*cwhip_template\b", cmake_text) or not re.search(
            r"\bcwhip_add_program\s*\(\s*hello\b", cmake_text):
        raise CwhipkgError("unsupported template: expected project(cwhip_template) and cwhip_add_program(hello)",
                           code="PKG1005")
    for path in root.rglob("*"):
        if path.is_file() and (path.name == "CMakeLists.txt" or path.suffix == ".md"):
            text = path.read_text(encoding="utf-8")
            text = re.sub(r"\bcwhip_template\b|\bhello\b|\bhello(?=_executable\b)", lambda _: name, text)
            text = text.replace("CWhip project template", name).replace("Cwhip project template", name)
            path.write_text(text, encoding="utf-8")


def command_new(name: str, directory: str | None, ref: str, source: str | None) -> None:
    reserved = {"all", "clean", "help", "install", "test", "package", "package_source",
                "edit_cache", "rebuild_cache", "preinstall", "ZERO_CHECK"}
    if (not valid_identifier(name) or not name[0].isalpha() or name in reserved
            or len(name) > 128):
        raise CwhipkgError("project name must be a non-reserved ASCII identifier starting with a letter (maximum 128 characters)",
                           code="PKG1003")
    if not ref or len(ref) > 256 or any(ord(c) < 32 or ord(c) == 127 for c in ref):
        raise CwhipkgError("template ref must be non-empty without control characters (maximum 256 characters)",
                           code="PKG0001")
    destination = Path(directory or name).absolute()
    if (destination.is_symlink() or (destination.exists() and
            (not destination.is_dir() or any(destination.iterdir())))):
        raise CwhipkgError(f"refusing non-empty, non-directory or symlink destination {destination}", code="PKG1004")
    if not destination.parent.is_dir():
        raise CwhipkgError(f"destination parent must already exist: {destination.parent}", code="PKG1004")
    if source:
        source_path = Path(source).expanduser().resolve()
        if source_path.is_dir() and destination.resolve().is_relative_to(source_path):
            raise CwhipkgError("destination must be outside the local template source directory", code="PKG1005")
    scratch = Path(tempfile.mkdtemp(prefix=".cwhip-new-", dir=destination.parent))
    try:
        archive_path = Path(source).expanduser().resolve() if source else scratch / "template.tar.gz"
        if source is None:
            url = "https://codeload.github.com/chucktilbury/cwhip-template/tar.gz/" + urllib.parse.quote(ref, safe="")
            try:
                with urllib.request.urlopen(url, timeout=30) as response, archive_path.open("wb") as stream:
                    total = 0
                    while chunk := response.read(64 * 1024):
                        total += len(chunk)
                        if total > TEMPLATE_MAX_DOWNLOAD:
                            raise CwhipkgError("template download exceeds 32 MiB limit", code="PKG3002")
                        stream.write(chunk)
            except (OSError, urllib.error.URLError, http.client.HTTPException) as error:
                raise CwhipkgError(f"cannot download template ref {ref!r} from {url}: {error}; use --source for offline creation",
                                   code="PKG3002") from error
        elif not archive_path.exists():
            raise CwhipkgError(f"local template source does not exist: {archive_path}", code="PKG1005")
        if archive_path.is_file() and archive_path.stat().st_size > TEMPLATE_MAX_DOWNLOAD:
            raise CwhipkgError("template archive exceeds 32 MiB limit", code="PKG1005")
        extracted = scratch / "extracted"
        extracted.mkdir()
        unpack_template(archive_path, extracted)
        root = extracted
        entries = list(root.iterdir())
        if not (root / "CMakeLists.txt").is_file() and len(entries) == 1 and entries[0].is_dir():
            root = entries[0]
        try:
            rename_template(root, name)
        except UnicodeError as error:
            raise CwhipkgError(f"template text must be UTF-8: {error}", code="PKG1005") from error
        # rename only replaces an empty directory; a concurrent non-empty destination is preserved.
        root.rename(destination)
    finally:
        original_error = sys.exception()
        try:
            shutil.rmtree(scratch)
        except OSError as error:
            report_error("PKG9002", f"cannot remove project staging directory {scratch}: {error}")
            if original_error is None:
                raise CwhipkgError(f"project staging cleanup failed: {scratch}", code="PKG9002") from error
    print(f"Created {name} in {destination} (no Git repository initialized).")
    print(f"Build: cmake -S {shell_quote(str(destination))} -B {shell_quote(str(destination / 'build'))}")
    print(f"       cmake --build {shell_quote(str(destination / 'build'))}")


def parse_arguments() -> argparse.Namespace:
    parser = DiagnosticArgumentParser(
        prog="cwhip-pkg",
        description="Prepare project modules and environment for the Cwhip compiler.",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    initialize = commands.add_parser("init", help="create cwhip-pkg.toml and an exact cwhip-pkg.lock")
    initialize.add_argument("project_dir", nargs="?", help="project directory (default: current directory)")
    add = commands.add_parser("add", help="install a package from a GitHub OWNER/REPO")
    add.add_argument("repository", help="GitHub repository in OWNER/REPO form")
    add.add_argument("version", nargs="?", help="exact stable SemVer tag (default: highest stable tag)")
    add.add_argument("--yes", action="store_true", help="consent to network access for declared sources")
    add.add_argument("--dry-run", action="store_true", help="show a plan without installing or updating configuration")
    install = commands.add_parser("install", help="restore the exact locked graph or resolve an unlocked manifest")
    install.add_argument("--yes", action="store_true", help="consent to network access for declared sources")
    install.add_argument("--dry-run", action="store_true", help="show a plan without installing or updating configuration")
    environment = commands.add_parser("env", help="print shell exports to activate this project")
    environment.add_argument("--preferences", metavar="FILE", help="use a TOML preferences file")
    commands.add_parser("list", help="list allowed and installed project modules")
    commands.add_parser("doctor", help="check SDK and host prerequisites without changing files or using the network")
    create = commands.add_parser("new", help="download a template archive and create a named project (no Git history)")
    create.add_argument("name", help="project/executable ASCII identifier starting with a letter")
    create.add_argument("directory", nargs="?", help="destination (default: ./NAME); parent must exist")
    create.add_argument("--ref", default="main", help="template branch, tag or commit (default: main)")
    create.add_argument("--source", metavar="PATH", help="use a local template directory, tar archive or ZIP instead of downloading")
    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    try:
        if arguments.command == "init":
            command_init(arguments.project_dir)
        elif arguments.command == "add":
            command_add(arguments.repository, arguments.version, arguments.yes, arguments.dry_run)
        elif arguments.command == "install":
            command_install(arguments.yes, arguments.dry_run)
        elif arguments.command == "env":
            command_env(arguments.preferences)
        elif arguments.command == "list":
            command_list()
        elif arguments.command == "doctor":
            command_doctor()
        elif arguments.command == "new":
            command_new(arguments.name, arguments.directory, arguments.ref, arguments.source)
    except CwhipkgError as error:
        report_error(error.code, str(error))
        return 2 if error.code == "PKG0001" else 1
    except OSError as error:
        report_error("PKG1002", str(error))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
