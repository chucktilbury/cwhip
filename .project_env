#!/usr/bin/env bash
# Init file for the project shell started by scripts/setup; do not run it
# directly. scripts/setup has already configured the build and exported
# _PROJECT_NAME, _PROJECT_LOC, _BUILD_TYPE, _PROJECT_BUILD_DIR and
# _PROJECT_STAGE_PREFIX.

if [[ -z "${_PROJECT_LOC:-}" || -z "${_PROJECT_BUILD_DIR:-}" ]]; then
    echo "error: .project_env is started by scripts/setup; run that instead." >&2
    return 1
fi

# Keep the setup values so the user's rc file cannot replace them.
__cwhip_saved=("$_PROJECT_NAME" "$_PROJECT_LOC" "$_BUILD_TYPE" "$_PROJECT_BUILD_DIR"
    "${_PROJECT_STAGE_PREFIX:-$_PROJECT_LOC}")

# Source the basic configuration for this shell
if [[ -f "$HOME/.bashrc" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.bashrc"
fi

export _PROJECT_NAME=${__cwhip_saved[0]}
export _PROJECT_LOC=${__cwhip_saved[1]}
export _BUILD_TYPE=${__cwhip_saved[2]}
export _PROJECT_BUILD_DIR=${__cwhip_saved[3]}
export _PROJECT_STAGE_PREFIX=${__cwhip_saved[4]}
unset __cwhip_saved
export HISTCONTROL=ignoreboth:erasedups

# The staged cwhip finds its resources relative to itself; clear overrides that
# would redirect it to an installed or stale tree.
unset CWHIP_HOME CWHIP_RUNTIME_DIR CWHIP_INCLUDE_DIR CWHIP_BUILTIN_DIR CWHIP_STDLIB_MODULE_DIR

# make some GIT shortcuts; nothing is added, committed or pushed implicitly.
function status {
    git status "$@"
}

function add {
    (cd -- "$_PROJECT_LOC" && git add .)
}

function commit {
    git commit "$@"
}

function push {
    git push "$@"
}

function all {
    (cd -- "$_PROJECT_LOC" && git add . && git commit && git push)
}

# dbg EXECUTABLE|SOURCE.cw [ARGS...]: open the cdbg debugger, falling back to
# KDbg when cdbg has not been built. Bare names resolve to staged binaries.
function dbg {
    if [[ $# -eq 0 ]]; then
        echo "error: executable name is required" >&2
        return 2
    fi
    local target=$1
    shift
    if [[ "$target" != */* && ! -e "$target" && -x "$_PROJECT_STAGE_PREFIX/bin/$target" ]]; then
        target=$_PROJECT_STAGE_PREFIX/bin/$target
    fi
    if command -v cdbg >/dev/null 2>&1; then
        if [[ $# -gt 0 ]]; then
            cdbg "$target" -- "$@"
        else
            cdbg "$target"
        fi
    elif command -v kdbg >/dev/null 2>&1; then
        if [[ $# -gt 0 ]]; then
            kdbg "$target" -a "$*"
        else
            kdbg "$target"
        fi
    else
        echo "error: no debugger found; build cdbg with 'build cdbg' or install kdbg" >&2
        return 127
    fi
}

__cwhip_path_prepend() {
    local entry=$1 rest=":$PATH:"
    while [[ "$rest" == *":$entry:"* ]]; do
        rest=${rest//":$entry:"/:}
    done
    rest=${rest#:}
    rest=${rest%:}
    PATH=$entry${rest:+:$rest}
}
__cwhip_path_prepend "$_PROJECT_LOC/scripts"
__cwhip_path_prepend "$_PROJECT_STAGE_PREFIX/bin"
unset -f __cwhip_path_prepend
export PATH
hash -r

PS1='\[\e[0;31;1m\]$_PROJECT_NAME($_BUILD_TYPE):\[\e[0m\]'${PS1-}

cd -- "$_PROJECT_BUILD_DIR" || cd -- "$_PROJECT_LOC" || true

if [[ ! -x "$_PROJECT_STAGE_PREFIX/bin/cwhip" ]]; then
    echo "note: $_PROJECT_STAGE_PREFIX/bin/cwhip is not built yet; run 'build' to build it."
fi
