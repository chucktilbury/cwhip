function(require_external_install_directory directory)
    # REALPATH alone does not resolve symlink parents of a not-yet-created path.
    set(existing_parent "${directory}")
    set(missing_suffix "")
    while(NOT EXISTS "${existing_parent}" AND NOT IS_SYMLINK "${existing_parent}")
        get_filename_component(name "${existing_parent}" NAME)
        set(missing_suffix "/${name}${missing_suffix}")
        get_filename_component(existing_parent "${existing_parent}" DIRECTORY)
    endwhile()
    get_filename_component(canonical_parent "${existing_parent}" REALPATH)
    get_filename_component(canonical_directory "${canonical_parent}${missing_suffix}" ABSOLUTE)
    foreach(forbidden_root IN ITEMS "${SOURCE_DIR}" "${BUILD_DIR}")
        get_filename_component(canonical_root "${forbidden_root}" REALPATH)
        file(RELATIVE_PATH relative_directory "${canonical_root}" "${canonical_directory}")
        if(relative_directory STREQUAL "" OR relative_directory STREQUAL "."
           OR (NOT IS_ABSOLUTE "${relative_directory}"
               AND NOT relative_directory MATCHES "^\\.\\.(/|$)"))
            message(FATAL_ERROR "Install test work directory must be outside ${forbidden_root}")
        endif()
    endforeach()
endfunction()

function(require_no_tree_references text context)
    foreach(forbidden_root IN ITEMS "${SOURCE_DIR}" "${BUILD_DIR}")
        get_filename_component(canonical_root "${forbidden_root}" REALPATH)
        foreach(root IN ITEMS "${forbidden_root}" "${canonical_root}")
            string(REGEX REPLACE "/+$" "" root "${root}")
            string(REGEX REPLACE "([][+.*()^$?|\\\\{}])" "\\\\\\1" root_pattern "${root}")
            if("${text}" MATCHES "${root_pattern}(/|$|[] \t\r\n\"');:,])")
                message(FATAL_ERROR
                    "${context} references the source or build tree ${forbidden_root}:\n${text}")
            endif()
        endforeach()
    endforeach()
endfunction()
